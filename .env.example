# heare environment variables
# Copy to .env and fill in values.

# Groq API key — used by the Pipecat GroqSTTService for Ukrainian speech-to-text.
# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API key — used for LLM generation (default provider).
# Optional (required if using openrouter provider). Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=

# z.ai API key — alternative LLM provider (can switch via 'heare provider zai').
# Optional (required if using zai provider).
ZAI_API_KEY=

# OpenCode Go API key — alternative LLM provider (can switch via 'heare provider opencode').
# Get a subscription at https://opencode.ai and run /connect to get your key.
# Optional (required if using opencode provider).
OPENCODE_API_KEY=

# Serper.dev API key — used for web search (Google results via API).
# Optional. If not set, falls back to DuckDuckGo HTML scraping (free, less reliable).
# Get 2,500 free queries at https://serper.dev
SERPER_API_KEY=

# NOT needed for the brain — heare uses the `claude` CLI for decider + action calls,
# and the `claude` CLI handles its own auth. Only set this if you want an
# Anthropic API fallback in the decider (not wired in Phase A).
# ANTHROPIC_API_KEY=
