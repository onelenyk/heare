[Unit]
Description=Heare Voice AI Assistant
Documentation=https://github.com/lenyk/myprojects/heare
After=sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/Users/lenyk/myprojects/heare/.venv/bin/python -m src.main start
WorkingDirectory=/Users/lenyk/myprojects/heare
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment file for API keys
EnvironmentFile=-%h/.heare/heare.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/Users/lenyk/.heare

# Resource limits
MemoryMax=500M
CPUQuota=200%

[Install]
WantedBy=default.target
