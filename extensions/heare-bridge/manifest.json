{
  "manifest_version": 3,
  "name": "Heare Bridge",
  "version": "0.1.0",
  "description": "WebSocket bridge between the Heare daemon and your Chrome browser.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "webNavigation",
    "offscreen"
  ],
  "minimum_chrome_version": "109",
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Heare Bridge",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
