# Heare Environment Variables
# Copy this file to ~/.heare/heare.env for systemd service

# Groq API Key (required)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override Claude Code CLI path
# HEARE_CLAUDE_CLI=/usr/local/bin/claude

# Optional: Override mode (silent|focus|ambient)
# HEARE_MODE=ambient

# Optional: Override heartbeat interval in minutes
# HEARE_HEARTBEAT_MIN=30
