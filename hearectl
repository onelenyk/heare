#!/bin/bash
# Heare control script - manage the voice AI assistant

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"

# Detect actual Python path from uv virtual environment
VENV_BIN="$PROJECT_DIR/.venv/bin"
if [ -d "$VENV_BIN" ]; then
    PYTHON="$VENV_BIN/python"
else
    # Fallback to uv run (may not work in background)
    PYTHON="uv run python"
fi

HEARE_HOME="$HOME/.heare"
PID_FILE="$HEARE_HOME/heare.pid"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

check_running() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            return 0
        else
            # Stale PID file
            rm -f "$PID_FILE"
            return 1
        fi
    fi
    return 1
}

cmd_start() {
    if check_running; then
        log_error "Heare is already running (PID: $(cat "$PID_FILE"))"
        log_info "Use '$0 restart' to restart"
        exit 1
    fi

    log_info "Starting Heare..."
    cd "$PROJECT_DIR"
    "$PYTHON" -m src.main start &
    local pid=$!

    # Wait for startup
    sleep 3

    if ps -p "$pid" > /dev/null 2>&1; then
        log_info "Heare started successfully (PID: $pid)"

        # Open log viewer in background if available
        if command -v tail >/dev/null 2>&1; then
            log_info "Logs: tail -f $HEARE_HOME/logs/daemon.log"
        fi
    else
        log_error "Failed to start Heare"
        exit 1
    fi

}

cmd_stop() {
    if ! check_running; then
        log_warn "Heare is not running"
        exit 0
    fi

    local pid=$(cat "$PID_FILE")
    log_info "Stopping Heare (PID: $pid)..."

    # Try graceful shutdown first
    kill "$pid" 2>/dev/null || true

    # Wait for process to exit
    local count=0
    while ps -p "$pid" > /dev/null 2>&1; do
        sleep 1
        count=$((count + 1))
        if [ $count -gt 10 ]; then
            log_warn "Graceful shutdown timeout, forcing..."
            kill -9 "$pid" 2>/dev/null || true
            sleep 1
            break
        fi
    done

    rm -f "$PID_FILE"
    log_info "Heare stopped"
}

cmd_restart() {
    log_info "Restarting Heare..."
    cmd_stop
    sleep 2
    cmd_start
}

cmd_status() {
    if check_running; then
        local pid=$(cat "$PID_FILE")
        log_info "Heare is running (PID: $pid)"

        # Get memory usage
        local mem=$(ps -o rss= -p "$pid" | awk '{sum+=$1} END {print sum}')
        if [ -n "$mem" ]; then
            local mem_mb=$((mem / 1024))
            log_info "Memory: ${mem_mb}MB"
        fi

        # Get uptime
        local elapsed=$(ps -o etime= -p "$pid" | tr -d ' ')
        if [ -n "$elapsed" ]; then
            log_info "Uptime: $elapsed"
        fi

        # Show recent logs
        if [ -f "$HEARE_HOME/logs/daemon.log" ]; then
            echo ""
            log_info "Recent log entries:"
            tail -5 "$HEARE_HOME/logs/daemon.log" 2>/dev/null || true
        fi
    else
        log_info "Heare is not running"
    fi
}

cmd_logs() {
    local log_file="$HEARE_HOME/logs/daemon.log"

    if [ ! -f "$log_file" ]; then
        log_error "Log file not found: $log_file"
        exit 1
    fi

    if [ -t 1 ]; then
        # Terminal
        log_info "Following logs (Ctrl-C to exit)..."
        tail -f "$log_file"
    else
        # Not a terminal
        cat "$log_file"
    fi
}

cmd_launch() {
    # Start daemon if not running
    if ! check_running; then
        log_info "Starting Heare daemon..."
        "$PYTHON" -m src.main start &
        local pid=$!
        sleep 5
        if ! ps -p "$pid" > /dev/null 2>&1; then
            log_error "Failed to start Heare"
            exit 1
        fi
        log_info "Heare started (PID: $pid)"
    else
        log_info "Heare already running (PID: $(cat "$PID_FILE"))"
    fi

    # Open desktop in browser
    log_info "Opening desktop at http://127.0.0.1:9780/"
    if command -v open >/dev/null 2>&1; then
        open "http://127.0.0.1:9780/"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "http://127.0.0.1:9780/"
    fi
}

cmd_install() {
    log_info "Installing Heare as a system service..."

    local service_file="$PROJECT_DIR/heare.service"
    local user_service_dir="$HOME/.config/systemd/user"

    if [ ! -f "$service_file" ]; then
        log_error "Service file not found: $service_file"
        exit 1
    fi

    # Create user systemd directory if it doesn't exist
    mkdir -p "$user_service_dir"

    # Copy service file
    cp "$service_file" "$user_service_dir/"

    # Reload systemd
    systemctl --user daemon-reload || {
        log_error "Failed to reload systemd. Is user systemd running?"
        log_info "Hint: export XDG_RUNTIME_DIR=/run/user/$(id -u)"
        exit 1
    }

    # Enable service
    systemctl --user enable heare.service
    systemctl --user start heare.service

    log_info "Heare installed as system service"
    log_info "Control with: systemctl --user start/stop/restart heare"
}

cmd_uninstall() {
    log_info "Uninstalling Heare system service..."

    local user_service_dir="$HOME/.config/systemd/user"
    local service_file="$user_service_dir/heare.service"

    if [ -f "$service_file" ]; then
        systemctl --user stop heare.service 2>/dev/null || true
        systemctl --user disable heare.service 2>/dev/null || true
        rm -f "$service_file"
        systemctl --user daemon-reload
        log_info "Heare service uninstalled"
    else
        log_warn "Heare service not installed"
    fi
}

cmd_help() {
    cat << EOF
Heare Control Script

Usage: $0 <command>

Commands:
    start         Start Heare daemon
    stop          Stop Heare daemon
    restart       Restart Heare daemon
    status        Show Heare status
    logs          Show/follow Heare logs
    launch        Start daemon + open desktop in browser
    install       Install as systemd user service
    uninstall     Remove systemd service
    help          Show this help message

Examples:
    $0 start              # Start in background
    $0 launch             # Start + open desktop
    $0 logs               # Follow logs
    $0 status             # Check if running

Environment:
    HEARE_HOME=$HEARE_HOME
    PID_FILE=$PID_FILE
EOF
}

# Main
case "${1:-help}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs
        ;;
    launch)
        cmd_launch
        ;;
    install)
        cmd_install
        ;;
    uninstall)
        cmd_uninstall
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        log_error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
