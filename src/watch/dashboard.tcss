/* Dashboard styling for Textual TUI */

Screen {
    overflow: hidden;
}

/* Select mode — changes all widget borders to dashed $warning so it's
   visually obvious that mouse passthrough is active. Widgets still
   update via the refresh timer; keyboard interaction works normally. */
Screen.select-mode ActivityTable,
Screen.select-mode LogTail,
Screen.select-mode HeaderBar,
Screen.select-mode DisplayPanel,
Screen.select-mode AgentResponseBar,
Screen.select-mode ControlsBar,
Screen.select-mode AIBar,
Screen.select-mode UsageBar,
Screen.select-mode VoiceStateBar {
    border: dashed $warning;
}

/* Unified border-title styling across the dashboard. */
HeaderBar, ActivityTable, LogTail, ControlsBar, AIBar, UsageBar, VoiceStateBar {
    border-title-color: $accent;
    border-title-style: bold;
    border-title-align: left;
}

/* ActivityTable width presets for column resize */
.activity-fit {
    width: auto;
}

.activity-half {
    width: 50%;
}

.activity-full {
    width: 100%;
}

ActivityTable {
    height: 1fr;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

ActivityTable:focus {
    border: round $accent-lighten-1;
}

/* Focus highlight for any other DataTable in the app */
DataTable:focus {
    border: tall $accent;
}

RichLog:focus {
    border: tall $accent;
}

/* Widget heights and borders */
LogTail {
    height: 8;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

LogTail:focus {
    border: round $accent-lighten-1;
}

HeaderBar {
    height: 4;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

DisplayPanel {
    height: 12;
    border: round $accent;
    padding: 0 1;
    background: $surface;
    layout: vertical;
}

#display-header {
    height: 1;
    width: 100%;
    align: right top;
}

#display-title-filler {
    width: 1fr;
}

#copy-display-btn {
    width: auto;
    min-width: 6;
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $accent-darken-2;
    color: $text;
}

#copy-display-btn:hover {
    background: $accent;
}

#display-content {
    height: 1fr;
    overflow-y: auto;
}

#display-content-inner {
    height: auto;
}

AgentResponseBar {
    height: 4;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

#bottom-bar {
    height: 8;
}

ControlsBar {
    width: 2fr;
    height: 100%;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

ControlsBar #sections-row {
    overflow-x: auto;
}

ControlsBar:focus-within {
    border: round $accent-lighten-1;
}

ControlsBar #status-line {
    height: 1;
}

ControlsBar #sections-row {
    height: 3;
}

ControlsBar Section {
    border: round $surface-darken-2;
    width: auto;
    height: 3;
    padding: 0 1;
    margin-right: 1;
}

ControlsBar #extras-line {
    height: 1;
    color: $text-muted;
}

ControlsBar.input-mode #sections-row,
ControlsBar.input-mode #extras-line {
    display: none;
}

ControlsBar Input {
    border: tall $accent;
    margin-top: 1;
}

AIBar {
    width: 1fr;
    height: 100%;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

UsageBar {
    width: 1fr;
    height: 100%;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}

VoiceStateBar {
    width: 1fr;
    height: 100%;
    border: round $accent;
    padding: 0 1;
    background: $surface;
}
